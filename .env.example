# Sanity → manage.sanity.io → your project → Project ID
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Optional: draft preview (token = Viewer role; secret = any random string)
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
# Keep mock catalog until Shopify is connected
USE_MOCK_DATA=true
SHOPIFY_MENU_HANDLE=main-menu
PUBLIC_STORE_DOMAIN = demo.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN = dummy